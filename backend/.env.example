# =============================================================================
# NextAction Backend Environment Configuration Template (.env.example)
# =============================================================================
PROJECT_NAME="NextAction API"
VERSION="0.1.0"
DESCRIPTION="Production Task & Follow-up Execution Engine"
API_V1_STR="/api/v1"

# Environment: development | test | staging | production
ENVIRONMENT=development
LOG_LEVEL=INFO
DOCS_ENABLED=true

# Database (PostgreSQL 16)
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_DB=nextaction
POSTGRES_USER=nextaction
POSTGRES_PASSWORD=your_secure_db_password_here
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800
DB_SSLMODE=

# JWT Secrets (Must be >= 32 characters in production: openssl rand -hex 32)
JWT_SECRET_KEY=generate_a_cryptographically_secure_random_hex_32_bytes_here
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Google OAuth Configuration
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
# GOOGLE_CLIENT_IDS=client-id-1.apps.googleusercontent.com,client-id-2.apps.googleusercontent.com

# Host & Port Binding (Render / Cloud Container support)
HOST=0.0.0.0
PORT=8000

# Rate Limiting & Redis (Local or Upstash Free Tier: rediss://default:<password>@<endpoint>.upstash.io:6379)
RATE_LIMIT_ENABLED=true
RATE_LIMIT_BACKEND=memory
RATE_LIMIT_MAX_ATTEMPTS=300
RATE_LIMIT_WINDOW_SECONDS=60
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=your_secure_redis_auth_password_here
REDIS_TIMEOUT_SECONDS=2.0
# REDIS_URL=rediss://default:your_upstash_password_here@your-endpoint.upstash.io:6379

# CORS & Trusted Hosts (Restricted to production origins)
CORS_ORIGINS=["https://nextaction.pages.dev","http://localhost:8080"]
TRUSTED_HOSTS=["nextaction.pages.dev","nextaction-api.onrender.com","localhost","127.0.0.1"]
FRONTEND_URL=https://nextaction.pages.dev
API_BASE_URL=https://nextaction-api.onrender.com

# Persistence Engine Selector: [postgresql | mongodb]
PERSISTENCE_ENGINE=postgresql

# MongoDB Configuration (Local or MongoDB Atlas M0 Free Tier)
MONGODB_ENABLED=false
# MONGODB_URI=mongodb+srv://nextaction_user:your_atlas_password_here@cluster0.abcde.mongodb.net/nextaction?retryWrites=true&w=majority
MONGODB_DATABASE=nextaction
MONGODB_MIN_POOL_SIZE=1
MONGODB_MAX_POOL_SIZE=50
MONGODB_SERVER_SELECTION_TIMEOUT_MS=5000
MONGODB_CONNECT_TIMEOUT_MS=5000

# Dual-Write Mode (Phase 31 - Default: false)
MONGODB_DUAL_WRITE_ENABLED=false
