# Global Security Headers for Cloudflare Pages
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=()

# SPA Entrypoints must not be cached aggressively to ensure immediate updates
/index.html
  Cache-Control: no-cache, no-store, must-revalidate
  Pragma: no-cache
  Expires: 0

/download.html
  Cache-Control: no-cache, no-store, must-revalidate

# Static Assets with Hash/Version identifiers can be cached for 1 year
/assets/*
  Cache-Control: public, max-age=31536000, immutable

/canvaskit/*
  Cache-Control: public, max-age=31536000, immutable
