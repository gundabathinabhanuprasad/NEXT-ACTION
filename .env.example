# =============================================================================
# NextAction Environment Configuration Template (.env.example)
# =============================================================================
# Instructions:
# 1. Never commit real secrets, private keys, or passwords to version control.
# 2. Duplicate this template to '.env' for local configuration.
# 3. Follow the section corresponding to your target deployment environment.
# =============================================================================

# -----------------------------------------------------------------------------
# Common Application Metadata
# -----------------------------------------------------------------------------
PROJECT_NAME="NextAction API"
VERSION="0.1.0"
DESCRIPTION="Production Task & Follow-up Execution Engine"
API_V1_STR="/api/v1"

# -----------------------------------------------------------------------------
# Environment Mode Selector: [development | test | staging | production]
# -----------------------------------------------------------------------------
ENVIRONMENT=development
LOG_LEVEL=INFO
DOCS_ENABLED=true
HOST=0.0.0.0
PORT=8000

# -----------------------------------------------------------------------------
# Database Configuration (PostgreSQL 16)
# -----------------------------------------------------------------------------
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_DB=nextaction
POSTGRES_USER=nextaction
POSTGRES_PASSWORD=your_secure_db_password_here

# Connection Pooling (Recommended: Pool Size 20, Overflow 40 in production)
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800

# Managed Database SSL Mode (e.g. require, verify-ca, verify-full, or leave empty for local)
DB_SSLMODE=

# Optional Direct Connection URL (overrides separate POSTGRES_* fields if specified)
# DATABASE_URL=postgresql+psycopg://user:password@host:port/dbname?sslmode=require

# -----------------------------------------------------------------------------
# Authentication & Cryptographic Keys
# -----------------------------------------------------------------------------
# MUST be generated using: openssl rand -hex 32 (minimum 32 characters in production)
JWT_SECRET_KEY=generate_a_cryptographically_secure_random_hex_32_bytes_here
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# -----------------------------------------------------------------------------
# Distributed Rate Limiting & Cache (Redis 7)
# -----------------------------------------------------------------------------
RATE_LIMIT_ENABLED=true
# Set to 'redis' for production/distributed deployment; 'memory' for single-node local development
RATE_LIMIT_BACKEND=memory
RATE_LIMIT_MAX_ATTEMPTS=300
RATE_LIMIT_WINDOW_SECONDS=60

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=your_secure_redis_auth_password_here
REDIS_TIMEOUT_SECONDS=2.0
# Optional direct Redis URL (e.g., rediss://:password@managed-redis.host:6379/0)
# REDIS_URL=

# -----------------------------------------------------------------------------
# Network, CORS & Host Boundaries
# -----------------------------------------------------------------------------
# JSON list or comma-separated list of origins. Wildcard '*' is rejected in production.
CORS_ORIGINS=["http://localhost:8080","http://127.0.0.1:8080"]
# Hostnames allowed in Host header (Required in production)
TRUSTED_HOSTS=["localhost","127.0.0.1","nextaction.local"]

FRONTEND_URL=http://localhost:8080
API_BASE_URL=http://localhost:8000

# -----------------------------------------------------------------------------
# Resource Guardrails
# -----------------------------------------------------------------------------
REQUEST_TIMEOUT_SECONDS=30
MAX_PAGE_SIZE=100
MAX_EXPORT_LIMIT=5000

# -----------------------------------------------------------------------------
# Persistence Engine Selector: [postgresql | mongodb]
# -----------------------------------------------------------------------------
# Default is 'postgresql'. Set to 'mongodb' to activate MongoDB repository persistence.
# Note: 'mongodb' requires MONGODB_ENABLED=true and a valid MONGODB_URI.
PERSISTENCE_ENGINE=postgresql

# -----------------------------------------------------------------------------
# MongoDB Configuration (Dual-Engine Scaffolding - Optional)
# -----------------------------------------------------------------------------
# Set MONGODB_ENABLED=true to activate MongoDB alongside or in place of PostgreSQL
MONGODB_ENABLED=false
# MongoDB connection URI (e.g. mongodb+srv://username:password@cluster.mongodb.net/nextaction?retryWrites=true&w=majority)
# MONGODB_URI=
MONGODB_DATABASE=nextaction
MONGODB_MIN_POOL_SIZE=1
MONGODB_MAX_POOL_SIZE=50
MONGODB_SERVER_SELECTION_TIMEOUT_MS=5000
MONGODB_CONNECT_TIMEOUT_MS=5000

# -----------------------------------------------------------------------------
# Controlled Dual-Write Mode (Phase 31 - Default: false)
# -----------------------------------------------------------------------------
# When enabled, writes commit to PostgreSQL first, then sync to MongoDB.
MONGODB_DUAL_WRITE_ENABLED=false
